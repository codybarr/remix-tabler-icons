{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remix-tabler-icons",
  "main": "website/worker.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist-website",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
